<?xml version="1.0"?>
<package format="2">
  <name>drone_assignment</name>
  <version>0.1.0</version>
  <description>ROS Noetic and Gazebo autonomous drone assignment.</description>
  <maintainer email="rover@itu.edu.tr">ITU Rover Drone</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>hector_uav_msgs</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>hector_gazebo_worlds</exec_depend>
  <exec_depend>hector_quadrotor_gazebo</exec_depend>
  <exec_depend>itu_s500_description</exec_depend>
</package>
