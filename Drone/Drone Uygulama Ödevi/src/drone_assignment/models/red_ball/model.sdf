<?xml version="1.0"?>
<sdf version="1.6">
  <model name="red_ball">
    <static>true</static>
    <link name="ball_link">
      <pose>0 0 0.25 0 0 0</pose>
      <collision name="collision">
        <geometry><sphere><radius>0.25</radius></sphere></geometry>
      </collision>
      <visual name="visual">
        <geometry><sphere><radius>0.25</radius></sphere></geometry>
        <material>
          <ambient>0.8 0.0 0.0 1</ambient>
          <diffuse>1.0 0.0 0.0 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
