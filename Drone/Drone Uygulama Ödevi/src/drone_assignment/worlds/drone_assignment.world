<?xml version="1.0"?>
<sdf version="1.6">
  <world name="drone_assignment_world">
    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ode">
      <max_step_size>0.0025</max_step_size>
      <real_time_update_rate>400</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.72 0.82 0.92 1</background>
      <shadows>true</shadows>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Drone düz bir hat üzerinde ilerlerken önce kırmızı topu, sonra ArUco'yu görür. -->
    <include>
      <uri>model://red_ball</uri>
      <name>red_ball_target</name>
      <pose>2.2 0.75 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://aruco_pad</uri>
      <name>aruco_landing_pad</name>
      <pose>5.3 0 0.012 0 0 0</pose>
    </include>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-6 -8 6 0 0.35 0.85</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
