<?xml version="1.0" ?>
<robot name="itu_s500" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<transmission name="prop_1_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="prop_1">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
  </joint>
  <actuator name="prop_1_actr">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

